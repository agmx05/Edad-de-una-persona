<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.edad.PrimaryController">

    <children>

        <Label text="Fecha de nacimiento"/>

        <TextField fx:id="txtedad"
                   promptText="dd/mm/aaaa"
                   maxWidth="200"
                   alignment="CENTER"/>

        <Button fx:id="btnCalcular"
                text="Calcular"
                onAction="#btnCalcular_click"/>

        <Button fx:id="btnLimpiar"
                text="Limpiar"
                onAction="#btnLimpiar_click"/>

        <Label fx:id="lbl1" text="Tienes años con meses"/>

    </children>

    <padding>
        <Insets bottom="20.0" left="20.0"  right="20.0" top="20.0"/>
    </padding>

</VBox>
